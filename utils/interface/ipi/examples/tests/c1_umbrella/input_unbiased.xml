<simulation verbosity='high'>
  <output prefix='simulation'>
    <properties stride='1' filename='out'>
      [ step, time{picosecond}, temperature{kelvin}, potential{atomic_unit} ]
    </properties>
    <trajectory filename='pos' stride='1' format='xyz' cell_units='angstrom'> positions{angstrom} </trajectory>
  </output>
  <total_steps>40</total_steps>
  <ffsocket mode='inet' name='sparc'>
    <address>localhost</address>
    <port>31441</port>
    <latency>0.01</latency>
    <timeout>600</timeout>
  </ffsocket>
  <system>
    <initialize nbeads='1'>
      <file mode='xyz'> init.xyz </file>
      <velocities mode='thermal' units='kelvin'> 0 </velocities>
    </initialize>
    <forces>
      <force forcefield='sparc'> </force>
    </forces>
    <motion mode='dynamics'>
      <dynamics mode='nvt'>
        <thermostat mode='langevin'>
          <tau units='femtosecond'> 2 </tau>
        </thermostat>
        <timestep units='femtosecond'> 1.0 </timestep>
      </dynamics>
    </motion>
    <ensemble>
      <temperature units='kelvin'> 1 </temperature>
    </ensemble>
  </system>
</simulation>
