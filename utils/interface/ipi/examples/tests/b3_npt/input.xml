<simulation verbosity='high'>
  <output prefix='simulation'>
    <properties stride='1' filename='out'>
      [ step, time{picosecond}, conserved{atomic_unit}, temperature{kelvin}, potential{atomic_unit}, volume{angstrom3}, pressure_md{gigapascal} ]
    </properties>
    <trajectory filename='pos' stride='5' format='xyz' cell_units='angstrom'> positions{angstrom} </trajectory>
  </output>
  <total_steps>30</total_steps>
  <ffsocket mode='inet' name='sparc'>
    <address>localhost</address>
    <port>31433</port>
    <latency>0.01</latency>
    <timeout>600</timeout>
  </ffsocket>
  <system>
    <initialize nbeads='1'>
      <file mode='xyz'> init.xyz </file>
      <velocities mode='thermal' units='kelvin'> 300 </velocities>
    </initialize>
    <forces>
      <force forcefield='sparc'> </force>
    </forces>
    <motion mode='dynamics'>
      <dynamics mode='npt'>
        <barostat mode='isotropic'>
          <thermostat mode='langevin'>
            <tau units='femtosecond'> 50 </tau>
          </thermostat>
          <tau units='femtosecond'> 50 </tau>
        </barostat>
        <thermostat mode='pile_g'>
          <tau units='femtosecond'> 25 </tau>
        </thermostat>
        <timestep units='femtosecond'> 1.0 </timestep>
      </dynamics>
    </motion>
    <ensemble>
      <temperature units='kelvin'> 300 </temperature>
      <pressure units='gigapascal'> 0.0 </pressure>
    </ensemble>
  </system>
</simulation>
