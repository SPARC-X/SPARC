<simulation verbosity='high'>
  <output prefix='simulation'>
    <properties stride='1' filename='out'>
      [ step, time{picosecond}, conserved{atomic_unit}, temperature{kelvin}, potential{atomic_unit} ]
    </properties>
    <trajectory filename='pos' stride='1' format='xyz'> positions{atomic_unit} </trajectory>
    <trajectory filename='frc' stride='1' format='xyz'> forces{atomic_unit} </trajectory>
  </output>

  <total_steps>5</total_steps>

  <ffsocket mode='inet' name='sparc'>
    <address>localhost</address>
    <port>31415</port>
    <latency>0.01</latency>
    <timeout>600</timeout>
  </ffsocket>

  <system>
    <initialize nbeads='1'>
      <file mode='xyz'> init.xyz </file>
      <velocities mode='thermal' units='kelvin'> 300 </velocities>
    </initialize>

    <forces>
      <force forcefield='sparc'> </force>
    </forces>

    <motion mode='dynamics'>
      <dynamics mode='nve'>
        <timestep units='femtosecond'> 1.0 </timestep>
      </dynamics>
    </motion>

    <ensemble>
      <temperature units='kelvin'> 300 </temperature>
    </ensemble>
  </system>
</simulation>
